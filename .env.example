# DATABASE (Supabase). Use the SESSION POOLER string (Supabase → Connect → Session pooler).
# The direct db.<ref>.supabase.co host is IPv6-only and is unreachable from Docker.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me

# Optional: auth emails
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# Public URL of this app. QR codes and labels point here, so use the address phones can reach.
BASE_URL=http://localhost:5000

# Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

NODE_ENV=development

# Frontend (baked in at build time; same values as above)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# Optional: Sentry
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Optional: Vercel Blob. Leave empty to store images on the local uploads volume (Docker).
BLOB_READ_WRITE_TOKEN=

# Key for the QGIS scan export: /api/scans.geojson?key=<this>. Leave empty to disable the export.
SCANS_EXPORT_KEY=
